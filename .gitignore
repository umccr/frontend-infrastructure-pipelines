# pnpm
.pnpm-store/
.pnpm-debug.log

*.js
# add except for jest.config.js
!jest.config.js
# CloudFront Function / Lambda source written in plain JS
!lib/**/lambda/**/*.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# OS
.DS_Store

# Python bytecode. Important: lib/portal/lambda/ is bundled by Code.fromAsset, so a stray
# __pycache__ there would be uploaded with the function and change its asset hash.
__pycache__/
*.py[cod]
